rules_version = '2';

// Milepost stores the whole trip in ONE document, at a path that is itself the
// secret. The trip code is substituted into this template at deploy time by
// tools/deploy-rules.js and the generated firestore.rules is gitignored — this
// repo is public, so a code committed here would be a code published.
//
// Why not Firebase Auth: enabling a sign-in provider on a fresh project routes
// through Identity Platform, which refuses without a billing account. A shared
// secret path gives equivalent practical protection for a holiday itinerary and
// needs no account, no billing, and no console.
//
// Enumeration is not possible: rules deny everything except this exact document
// id, and listing the collection is denied, so the code cannot be discovered by
// probing. 80 bits of entropy.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow read, write: if tripId == '__TRIP_CODE__';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
